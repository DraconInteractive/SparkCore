# Explicit --config file fields override these database/storage defaults.
# See docs/configuration.md; .env.local is not automatically loaded.
# Optional overrides. localhost uses the local Unix socket and OS-user authentication.
SPARK_DB_HOST=localhost
SPARK_DB_NAME=spark
# SPARK_DB_USER defaults to USER; set explicitly if running under a service supervisor.
# SPARK_DB_USER=demo
# SPARK_DB_SOCKET=/run/mysqld/mysqld.sock
# SPARK_DB_PORT=3306
# For a separately provisioned password-authenticated database account:
# SPARK_DB_PASSWORD=

# File bytes live on disk. Use a stable absolute path when running as a service.
# SPARK_FILE_DIR=/home/demo/spark/storage/files

# Offline backups: mount the external drive and stop SPARK before running backup.sh.
# Quote paths containing spaces when sourcing this file in a shell.
# SPARK_BACKUP_MOUNT="/media/demo/backup-drive"
# SPARK_BACKUP_DIR="/media/demo/backup-drive/spark-backups"
# Optional local history of successful backup destinations (default storage/backup-locations.tsv).
# SPARK_BACKUP_HISTORY=/home/demo/spark/storage/backup-locations.tsv
