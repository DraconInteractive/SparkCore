# Optional overrides. localhost uses the local Unix socket and OS-user authentication.
SPARK_DB_HOST=localhost
SPARK_DB_NAME=spark
# SPARK_DB_USER defaults to USER; set explicitly if running under a service supervisor.
# SPARK_DB_USER=demo
# SPARK_DB_SOCKET=/run/mysqld/mysqld.sock
# SPARK_DB_PORT=3306
# For a separately provisioned password-authenticated database account:
# SPARK_DB_PASSWORD=

# File bytes live on disk. Use a stable absolute path when running as a service.
# SPARK_FILE_DIR=/home/demo/spark/storage/files
