[Unit]
Description=SPARK TCP TLS notification proxy
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/spark/nginx-tcp.conf
ExecStart=/usr/sbin/nginx -c /etc/spark/nginx-tcp.conf
ExecReload=/usr/sbin/nginx -t -c /etc/spark/nginx-tcp.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
RuntimeDirectory=spark-tcp-proxy
RuntimeDirectoryMode=0700
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
ReadWritePaths=/run/spark-tcp-proxy

[Install]
WantedBy=multi-user.target
